{
  "info": {
    "name": "Banking Transactions API",
    "description": "Generated from banking-transactions-openapi.yaml (API version 1.1.0). Set baseUrl, bearerToken, and accountId before sending requests. The sandbox URL in the contract is a placeholder. Set payeeAccountId for payments and originalTransactionId for refunds. Successful create requests save a separate transaction ID for each type. PUT replaces all editable fields; omitted optional fields are cleared. Only PENDING transactions can be updated or deleted; other states return 409. DELETE removes the transaction from API reads and lists while retaining internal audit records. Running the entire collection creates, updates, and deletes transactions. Health does not require authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sandbox.api.example.com/v1",
      "type": "string",
      "description": "Replace with your API URL; no trailing slash."
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string",
      "description": "Set a valid bearer token before calling transaction endpoints."
    },
    {
      "key": "accountId",
      "value": "ACCOUNT001",
      "type": "string",
      "description": "Replace with an existing 10-character alphanumeric account ID."
    },
    {
      "key": "payeeAccountId",
      "value": "PAYEE00001",
      "type": "string",
      "description": "Replace with an existing 10-character destination account ID."
    },
    {
      "key": "originalTransactionId",
      "value": "",
      "type": "string",
      "description": "Set an existing transaction ID eligible for a refund."
    },
    {
      "key": "limit",
      "value": "20",
      "type": "string",
      "description": "Page size: 1 to 100."
    },
    {
      "key": "offset",
      "value": "0",
      "type": "string",
      "description": "Non-negative number of transactions to skip."
    },
    {
      "key": "depositTransactionId",
      "value": "",
      "type": "string",
      "description": "Set an existing deposit ID, or send Create to capture its returned ID automatically."
    },
    {
      "key": "withdrawalTransactionId",
      "value": "",
      "type": "string",
      "description": "Set an existing withdrawal ID, or send Create to capture its returned ID automatically."
    },
    {
      "key": "refundTransactionId",
      "value": "",
      "type": "string",
      "description": "Set an existing refund ID, or send Create to capture its returned ID automatically."
    },
    {
      "key": "checkTransactionId",
      "value": "",
      "type": "string",
      "description": "Set an existing check ID, or send Create to capture its returned ID automatically."
    },
    {
      "key": "paymentTransactionId",
      "value": "",
      "type": "string",
      "description": "Set an existing payment ID, or send Create to capture its returned ID automatically."
    }
  ],
